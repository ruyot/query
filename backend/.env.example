# SerpAPI Configuration
SERPAPI_KEY=your_serpapi_key_here

# Elasticsearch Configuration (Local)
ES_HOST=localhost
ES_PORT=9200
ES_INDEX=search_results

# Elasticsearch Cloud Configuration (Optional)
# ES_CLOUD_ID=your_cloud_id
# ES_API_KEY=your_api_key

# GCP Vertex AI Model Endpoint (will be provided)
GCP_MODEL_ENDPOINT=https://your-endpoint.run.app/predict
GCP_PROJECT_ID=your-project-id

# API Server Configuration
API_PORT=5000
API_HOST=0.0.0.0

# Scoring Configuration
BASE_WEIGHT=0.6
RECENCY_WEIGHT=0.4
DECAY_DAYS=30
